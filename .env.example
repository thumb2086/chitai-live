# StreamFlow Configuration
DATABASE_URL="file:./prisma/dev.db"

# ── Twitch OAuth ──
# 1. Go to https://dev.twitch.tv/console/apps
# 2. Create a new application
# 3. Set OAuth Redirect URL to: http://localhost:3000/api/auth/callback
# 4. Copy Client ID and Client Secret below
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── YouTube (Google) OAuth ──
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add redirect URI: http://localhost:3000/api/auth/callback
# 4. Enable YouTube Data API v3
# 5. Copy Client ID and Client Secret below
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# �w�w Chat Worker �w�w
# ���N�üƪ��_�A�Ω�O�@ chat worker �� API ���q�T
CHAT_WORKER_KEY=dev-key

# Etherscan API Key (自動檢查 ZXC/YJC 鏈上轉帳)。
# 2026-10-06：從 BASESCAN 改成 ETHERSCAN —— 合約在 Ethereum Sepolia
# (chainId 11155111)，而 BaseScan 查的是 Base Sepolia，所以舊設定
# 永遠查無此筆轉帳。
# ETHERSCAN_API_KEY=你的_API_Key

# ── ZIXI OAuth ──
# zixi-earth 是 OAuth provider（/api/oauth/*）
# ZIXI_CLIENT_ID 和 ZIXI_CLIENT_SECRET 由 zixi-earth 管理員建立
# （scripts/sync-secrets-to-cf.cjs 會自動註冊並把 secret 推到 CF）
ZIXI_CLIENT_ID=livestream-dashboard
ZIXI_CLIENT_SECRET=
ZIXI_OAUTH_URL=https://zixiearth.dpdns.org

# zixi-earth Worker，轉帳與對帳的真正存放處。
# 2026-10-06：原本的 fallback 是 zixi-casino-api.onrender.com（已逾時）
# 與 zixi-casino.vercel.app（該專案已拋棄）。
# ⚠️ workers.dev 也不能用 —— zixi-earth 加了 custom domain 之後，
#    wrangler 會停用 workers.dev 子網域，該網址現在整站 404。
ZIXI_API_URL=https://zixiearth.dpdns.org

# ZIXI Admin Session (後備方案，用於 admin-transfer 等需要管理員權限的操作)
# 在 zixiearth 以管理員登入後取得 sessionId 填入
ZIXI_ADMIN_SESSION=

# --- Groq transcription (src/lib/captions-groq.ts) --------------------
# Two providers are tried in order; the first configured one wins and the other
# stays as a fallback.

# 1) direct — fastest path, one HTTPS hop. Single key, so no rotation.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) router — slower (extra serverless hop) but rotates ~30 keys with cooldown
#    and credit accounting, so a long stream cannot get rate-limited off air.
# ★ 只用於 chat/embedding（src/lib/rag.ts 打 /v1/embeddings 與 /v1/chat/completions）。
#   這兩個端點還活著，不要動。
# ★ 錄音轉寫**不要**用這個 —— groq-router 的 /api/transcriptions 已停用（回 410）。
GROQ_ROUTER_URL=https://vercel-router-khaki.vercel.app

# 錄音轉寫（字幕）專用的代理。
# 與 GROQ_ROUTER_URL 分開的原因：groq-router 的 /api/transcriptions 刻意停用了
# （STT_LEGACY_ENABLED !== "1" 時回 410），body 裡指名改用這個主機。
# 實測 2026-10-17：舊的 /api/transcriptions → 410；這個 → 401（活的，要認證）。
STT_PROXY_URL=https://stt.twonline.dpdns.org/v1
GROQ_ROUTER_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# true = direct first then router. false = always via the router.
GROQ_DIRECT_FIRST=true

# ★ 一定要填正式網域，不能留空。
#   OAuth 的 redirect_uri 會用它組成，送給 Twitch/Google 後要**完全相符**，
#   差一個字元就 redirect_mismatch。
#   留空會退化成「當下請求的 origin」—— 本機開發就是 localhost:3000，
#   對方立刻拒絕。這正是 2026-10-14 踩到的坑。
PUBLIC_BASE_URL=https://zixilive.dpdns.org